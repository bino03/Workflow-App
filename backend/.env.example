# Workflow App — backend. Ver docs/environment.md. Nunca pôr aqui uma chave da Anthropic.
HOST=127.0.0.1
PORT=7400
LOG_LEVEL=info

# O nome de utilizador do login (ADR 0011)
APP_USERNAME=
# npm run hash-password
APP_PASSWORD_HASH=
# 64+ caracteres aleatórios
SESSION_SECRET=
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
COOKIE_SECURE=false
# separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:7401,http://127.0.0.1:7401

# Passkeys (ADR 0015). Mudar o RP_ID invalida as passkeys registadas. Abrir a app em localhost, não em 127.0.0.1.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Workflow App
# WEBAUTHN_ORIGINS=

# Claude Code (processo local, com o login da subscrição)
CLAUDE_BIN=claude
ALLOWED_ROOTS=C:\Users\jlalv\Desktop\utad\projetos;C:\Users\jlalv\Desktop\Workflow
DEFAULT_CWD=
# Pasta de configuração do Claude Code (omissão ~/.claude). Absoluta. Nunca deixar a linha vazia sem #.
# CLAUDE_CONFIG_DIR=
MAX_TERMINALS=8
SCROLLBACK_BYTES=1048576

# Biblioteca do Workflow (só leitura)
WORKFLOW_PATH=C:\Users\jlalv\Desktop\Workflow\Workflow

# Estado persistido — state.json (omissão: ~/.workflow-app). Absoluto; criada se não existir.
# DATA_DIR=

# Build do frontend servido pelo backend (omissão: ../frontend/dist). Absoluto. Sem index.html → só a API.
# FRONTEND_DIST=

# Bot de Telegram (ADR 0017) — opcional; sem token o bot não arranca. Token do @BotFather; o teu ID do @userinfobot.
# Nunca dar o token real a uma instância de teste (dois backends com o mesmo token → 409 no Telegram).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_ID=

# Pré-visualização de apps em dev por `tailscale serve`, só na tailnet (ADR 0018) — opcional; sem binário fica desligada.
# Windows: C:\Program Files\Tailscale\tailscale.exe · Linux: tailscale (o utilizador tem de ser operator: sudo tailscale set --operator=$USER)
# TAILSCALE_BIN=
# Portas HTTPS do serve (lista e/ou intervalos, máx. 32, nunca a PORT). Omissão 8443-8446.
# PREVIEW_HTTPS_PORTS=8443-8446
