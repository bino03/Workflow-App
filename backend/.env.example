# Workflow App — backend. Ver docs/environment.md. Nunca pôr aqui uma chave da Anthropic.
HOST=127.0.0.1
PORT=7400
LOG_LEVEL=info

# O nome de utilizador do login (ADR 0011)
APP_USERNAME=
# npm run hash-password
APP_PASSWORD_HASH=
# 64+ caracteres aleatórios
SESSION_SECRET=
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
COOKIE_SECURE=false
# separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:7401,http://127.0.0.1:7401

# Claude Code (processo local, com o login da subscrição)
CLAUDE_BIN=claude
ALLOWED_ROOTS=C:\Users\jlalv\Desktop\utad\projetos;C:\Users\jlalv\Desktop\Workflow
DEFAULT_CWD=
# Pasta de configuração do Claude Code (omissão ~/.claude). Absoluta. Nunca deixar a linha vazia sem #.
# CLAUDE_CONFIG_DIR=
MAX_TERMINALS=8
SCROLLBACK_BYTES=1048576

# Biblioteca do Workflow (só leitura)
WORKFLOW_PATH=C:\Users\jlalv\Desktop\Workflow\Workflow

# Estado persistido — state.json (omissão: ~/.workflow-app). Absoluto; criada se não existir.
# DATA_DIR=

# Build do frontend servido pelo backend (omissão: ../frontend/dist). Absoluto. Sem index.html → só a API.
# FRONTEND_DIST=
